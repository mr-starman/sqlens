{
  "settings": { "maxGridRows": 50000 },
  "datasources": [
    {
      "name": "chinook",
      "description": "c-treeRTG on localhost, database chinook",
      "url": "jdbc:ctree:6597@localhost:chinook",
      "driver": "ctree.jdbc.ctreeDriver",
      "user": "ADMIN",
      "password": "ADMIN"
    },
    {
      "name": "chinook-readonly",
      "description": "Same database, writes blocked",
      "url": "jdbc:ctree:6597@localhost:chinook",
      "driver": "ctree.jdbc.ctreeDriver",
      "user": "ADMIN",
      "password": "${CTREE_PASSWORD}",
      "readOnly": true,
      "queryTimeoutSeconds": 60
    },
    {
      "name": "ctree-test-server",
      "description": "c-treeRTG on another host",
      "url": "jdbc:ctree:6597@testhost:ctreeSQL",
      "user": "ADMIN",
      "password": "${CTREE_PASSWORD}"
    },
    {
      "name": "local-postgres",
      "description": "Any other JDBC database works the same way",
      "url": "jdbc:postgresql://localhost:5432/app",
      "user": "app",
      "password": "${PGPASSWORD}"
    },
    {
      "name": "h2-scratch",
      "description": "Throwaway in-memory database",
      "url": "jdbc:h2:mem:scratch;DB_CLOSE_DELAY=-1",
      "user": "sa",
      "password": ""
    }
  ]
}
